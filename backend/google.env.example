# Secret-free reference only. Run configure_google.py interactively on the host.
# Never paste a client secret into chat, GitHub, screenshots or shell arguments.
APP_PUBLIC_URL=https://newfind-khaki.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Auth Platform → Clients → Web application:
# JavaScript origin: https://newfind-khaki.vercel.app
# Redirect URI: https://newfind-khaki.vercel.app/auth/google/callback
# Request only OpenID, email and profile. This does not require Gmail API access.

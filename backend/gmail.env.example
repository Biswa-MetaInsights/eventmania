# NewFind Gmail sender selected by the owner; this file contains no credentials.
# Merge these values into /opt/newfind/.env only when SMTP_PASSWORD is supplied
# securely on the host. Never commit that .env or enable a half-configured sender.
# Gmail app passwords require 2-Step Verification on the Google account.
# https://support.google.com/mail/answer/185833
APP_PUBLIC_URL=https://newfind-khaki.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=NewFind by MetaInsights BV <metainsights.bv@gmail.com>
SMTP_USERNAME=metainsights.bv@gmail.com
SMTP_PASSWORD=
